<% 
  // password-changed.ejs expects: name
%>
<% const content = `
<h2>Password Changed</h2>
<p>Hi ${name},</p>
<p>This is a confirmation that the password for your Raantech Dashboard account was recently changed.</p>

<p>If you made this change, you can safely ignore this email.</p>

<p style="margin-top: 32px; font-size: 14px;">If you didn't change your password, please contact an administrator immediately.</p>
` %>
<%- include('base', { content }) %>
