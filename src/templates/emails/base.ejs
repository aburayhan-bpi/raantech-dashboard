<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    /* Reset & Base Styles */
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #F4F7F9;
      color: #374151;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    
    table {
      border-collapse: collapse;
      width: 100%;
    }
    
    /* Layout */
    .wrapper {
      width: 100%;
      background-color: #F4F7F9;
      padding: 64px 0;
    }
    
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
    }
    
    .header {
      padding: 48px 48px 0;
    }
    
    .header-table {
      width: 100%;
      padding-bottom: 12px;
    }
    
    .header img {
      height: 48px;
      width: auto;
      display: block;
    }
    
    /* Body Content */
    .content {
      padding: 32px 48px 48px;
    }
    
    h2 {
      margin-top: 0;
      color: #0F172A;
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 24px;
      letter-spacing: -0.02em;
    }
    
    p {
      margin-top: 0;
      margin-bottom: 24px;
      font-size: 16px;
      color: #334155;
      line-height: 1.6;
    }
    
    /* Button */
    .btn-container {
      margin: 32px 0;
      text-align: center;
    }
    
    .btn {
      display: inline-block;
      background-color: #0ea5e9;
      color: #ffffff !important;
      text-decoration: none;
      padding: 14px 32px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 16px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 6px -1px rgba(14, 165, 233, 0.3), 0 2px 4px -1px rgba(14, 165, 233, 0.2);
    }
    
    /* Alert / Warning Boxes */
    .alert {
      background-color: #F8FAFC;
      border-radius: 8px;
      padding: 24px;
      margin: 24px 0;
      font-size: 14px;
      color: #374151;
      border: 1px solid #E2E8F0;
    }
    
    /* Data Tables */
    .data-table {
      width: 100%;
      margin: 32px 0;
    }
    
    .data-table th {
      color: #6B7280;
      font-weight: 500;
      text-align: left;
      padding: 12px 0;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid #E5E7EB;
    }
    
    .data-table td {
      padding: 16px 0;
      border-bottom: 1px solid #E5E7EB;
      font-size: 15px;
      color: #111827;
    }
    
    /* Footer */
    .footer {
      padding: 32px 48px;
      text-align: center;
      background-color: #F8FAFC;
    }
    
    .footer p {
      margin: 0;
      color: #64748B;
      font-size: 14px;
      line-height: 1.6;
    }
    
    /* Responsive */
    @media only screen and (max-width: 600px) {
      .container {
        border-radius: 0;
        border-left: none;
        border-right: none;
      }
      .header, .content, .footer {
        padding: 32px 24px;
      }
      .wrapper {
        padding: 0;
      }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      
      <!-- Header -->
      <div class="header">
        <table class="header-table">
          <tr>
            <td style="text-align: left; vertical-align: middle;">
              <a href="<%= locals.appUrl || 'https://raantech.com' %>">
                <img src="<%= locals.appUrl || 'https://raantech.com' %>/brand-logo.png" alt="Raantech" />
              </a>
            </td>
            <td style="text-align: right; vertical-align: middle;">
              <span style="font-size: 13px; color: #6B7280; font-weight: 500;"><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            </td>
          </tr>
        </table>
      </div>
      
      <!-- Dynamic Content -->
      <div class="content">
        <%- content %>
      </div>
      
      <!-- Footer -->
      <div class="footer">
        <p>This is an automated notification from Raantech. Please do not reply to this email.</p>
        <p style="margin-top: 8px;">&copy; <%= new Date().getFullYear() %> Raantech. All rights reserved.</p>
      </div>
      
    </div>
  </div>
</body>
</html>
