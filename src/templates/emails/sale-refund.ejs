<% 
  // sale-refund.ejs expects: customerName, saleNo, refundAmount, refundMethod, note, totalPaid, totalRefundedSoFar, remainingRefundDue
%>
<% const content = `
<h2>Refund Processed</h2>
<p>Hi ${customerName},</p>
<p>We have successfully processed a refund for your order <strong>#${saleNo}</strong>.</p>

<div style="margin: 32px 0; padding: 24px; border: 1px solid #10B98140; background-color: #ECFDF5; border-radius: 8px; text-align: center;">
  <p style="margin: 0; font-size: 12px; color: #065F46; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Refund Amount</p>
  <p style="margin: 8px 0 0 0; font-size: 32px; font-weight: 700; color: #10B981;">৳ ${refundAmount.toLocaleString()}</p>
</div>

<div style="margin: 32px 0 0 0; padding-top: 24px; border-top: 1px solid #E5E7EB;">
  <p style="margin: 0 0 16px 0; font-size: 14px; font-weight: 600; color: #111827;">Refund Details</p>
  <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
    <tr>
      <td style="padding: 8px 0; color: #6B7280; width: 150px;">Refund Method:</td>
      <td style="padding: 8px 0; color: #374151; font-weight: 500;">${refundMethod}</td>
    </tr>
    ${(note && note.trim() !== '') ? `
    <tr>
      <td style="padding: 8px 0; color: #6B7280;">Note / Reference:</td>
      <td style="padding: 8px 0; color: #374151;">${note}</td>
    </tr>
    ` : ''}
  </table>
</div>

<div style="margin: 32px 0 0 0; padding-top: 24px; border-top: 1px solid #E5E7EB;">
  <p style="margin: 0 0 16px 0; font-size: 14px; font-weight: 600; color: #111827;">Payment Summary</p>
  <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
    <tr>
      <td style="padding: 8px 0; color: #6B7280; width: 200px;">Total Paid Amount:</td>
      <td style="padding: 8px 0; color: #374151;">৳ ${totalPaid.toLocaleString()}</td>
    </tr>
    <tr>
      <td style="padding: 8px 0; color: #6B7280;">Total Refunded (Including this):</td>
      <td style="padding: 8px 0; color: #10B981; font-weight: 500;">৳ ${totalRefundedSoFar.toLocaleString()}</td>
    </tr>
    ${remainingRefundDue > 0 ? `
    <tr>
      <td style="padding: 8px 0; color: #6B7280;">Remaining Refund Due:</td>
      <td style="padding: 8px 0; color: #EF4444; font-weight: 500;">৳ ${remainingRefundDue.toLocaleString()}</td>
    </tr>
    ` : ''}
  </table>
</div>

<p>Please allow 1-3 business days for the amount to reflect in your account, depending on the payment method.</p>
<p>If you have any questions, simply reply to this email or reach out to our support team.</p>
` %>
<%- include('base', { content }) %>
