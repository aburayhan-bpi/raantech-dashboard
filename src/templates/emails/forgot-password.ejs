<% 
  // forgot-password.ejs expects: name, email, resetUrl 
%>
<% const content = `
<h2>Reset Password</h2>
<p>Hi ${name},</p>
<p>We received a request to reset the password for your Raantech Dashboard account (${email}).</p>

<div class="btn-container">
  <a href="${resetUrl}" class="btn">Reset Password</a>
</div>

<p>This link will expire in 15 minutes. If you didn't request a password reset, you can safely ignore this email.</p>

<p style="margin-top: 32px; font-size: 14px; color: #6B7280;">If the button doesn't work, copy and paste this URL into your browser:<br>
<span style="color: #4F46E5; word-break: break-all;">${resetUrl}</span></p>
` %>
<%- include('base', { content }) %>
